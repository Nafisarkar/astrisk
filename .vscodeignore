.gitignore
# sources and tests never ship
src/**
test/**
out/test/**
.vscode/**
.vscode-test/**
node_modules/**

# project files that only matter in the repo
docs/**
.impeccable/**
FEATURES.md
PRODUCT.md
DESIGN.md
bunfig.toml
package-lock.json
tsconfig.json
eslint.config.mjs
**/*.map
**/*.ts
**/.vscode-test.*
.yarnrc

# stray scratch files at the root: only the manifest ships as JSON
/*.json
!package.json

.github/**

# never ship a package inside a package
**/*.vsix
.asterisk/**

# art that isn't referenced by the manifest
media/icon-512.png
media/icon-badge.svg
